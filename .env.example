# Copy to .env and fill in. Never commit .env.
DEPLOY_MODE=LOCAL
# Hosted frontend origin(s), comma-separated. Required when DEPLOY_MODE=CLOUD.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Hosted backend hostname(s), without scheme. Required when DEPLOY_MODE=CLOUD.
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
# Proxies in front of the API that append to X-Forwarded-For (0 locally; see HOSTING.md).
TRUSTED_PROXY_HOPS=0
# Daily /chat caps per UTC day and cached-answer expiry; 0 = off. CLOUD defaults: 25, 100, 7.
DAILY_CHAT_LIMIT_PER_CLIENT=0
DAILY_CHAT_BUDGET=0
LLM_CACHE_TTL_DAYS=0
EXPOSE_PROVIDER_ERRORS=true
# Empty uses the local Vite proxy/same origin. Set to the deployed API origin for a separately hosted frontend.
VITE_API_BASE_URL=
# Cloudflare Turnstile bot check (free; see HOSTING.md). Both empty = off.
# The site key is public and goes to the frontend build; the secret stays on the backend.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Signs bot-check sessions. Empty = random per process (sessions end on restart).
SESSION_SIGNING_KEY=
SESSION_TTL_SECONDS=7200
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_READ_TIMEOUT=45
GEMINI_MAX_RETRIES=1
GEMINI_THINKING_LEVEL=low
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_READ_TIMEOUT=30
GROQ_MAX_RETRIES=1
GROQ_REASONING_EFFORT=low
# Upper bound on one Groq reply, reasoning included.
GROQ_MAX_COMPLETION_TOKENS=2048
# Entries are "provider" or "provider:model"; quotas are per model, so e.g.
# groq,groq:qwen/qwen3.8-27b,gemini,ollama adds a second free Groq budget.
LLM_PROVIDER_ORDER=groq,gemini,ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
USE_GPU=false
ENABLE_VECTOR_RETRIEVAL=true
ENABLE_CROSS_ENCODER=false
# Who decides claim support: llm (batched judge call, default), lexical, or nli. See SUPPORT_REPORT.md.
SUPPORT_CHECKER=llm
# The judge runs on its own models so it does not spend the answer model's daily quota.
SUPPORT_JUDGE_PROVIDERS=groq:openai/gpt-oss-20b,groq,gemini
