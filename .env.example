# Copy to .env and fill in. Never commit .env.
DEPLOY_MODE=LOCAL
# Hosted frontend origin(s), comma-separated. Required when DEPLOY_MODE=CLOUD.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Hosted backend hostname(s), without scheme. Required when DEPLOY_MODE=CLOUD.
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
EXPOSE_PROVIDER_ERRORS=true
# Empty uses the local Vite proxy/same origin. Set to the deployed API origin for a separately hosted frontend.
VITE_API_BASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_READ_TIMEOUT=45
GEMINI_MAX_RETRIES=1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_READ_TIMEOUT=30
GROQ_MAX_RETRIES=1
LLM_PROVIDER_ORDER=gemini,groq,ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
USE_GPU=false
ENABLE_VECTOR_RETRIEVAL=true
ENABLE_CROSS_ENCODER=false
